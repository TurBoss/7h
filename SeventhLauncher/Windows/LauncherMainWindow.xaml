<Window x:Class="SeventhLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SeventhLauncher"
        xmlns:ctrl="https://7thheaven.rocks/SeventhHeavenUI/UserControls"
        xmlns:cls="https://7thheaven.rocks/SeventhHeavenUI/Classes"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        mc:Ignorable="d"
        Title="FF7OR v1.0"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Height="720"
        Width="1024"
        MinHeight="640" MinWidth="1024"
        ResizeMode="NoResize" Icon="/Launcher/custom_logo.png" Background="Black">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <TabControl x:Name="main_control" Grid.ColumnSpan="2" Grid.RowSpan="2" Foreground="Black" Background="#00000000" Margin="0,0,-0.4,0" BorderBrush="#00000000">
        <TabItem x:Name="main_tab" Header="Main">
            <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Width="1018" Height="616">
                <Grid.Background>
                    <ImageBrush Stretch="UniformToFill" ImageSource="/Windows/ova_bg.png"/>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="511*"/>
                    <ColumnDefinition Width="507*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="play_button" Content="Play" Height="58" Margin="144,0,0,0" Width="226" HorizontalAlignment="Left" VerticalAlignment="Center" Click="play_button_Click" Foreground="#FF25A98E" FontSize="28" Grid.Column="1" BorderBrush="#FF1C9682" FontWeight="Bold"/>
                <Button x:Name="quit_button" Content="Quit" Height="58" Margin="144,412,0,0" Width="226" HorizontalAlignment="Left" VerticalAlignment="Top" Click="quit_button_Click" Foreground="#FF1C9682" FontSize="28" Grid.Column="1" BorderBrush="#FF1C9682" FontWeight="Bold"/>
                <Button x:Name="options_button" Content="Options" Height="56" Margin="144,346,0,0" Width="226" HorizontalAlignment="Left" VerticalAlignment="Top" Click="options_button_Click" Foreground="#FF25A98E" FontSize="28" Grid.Column="1" BorderBrush="#FF1C9682" FontWeight="Bold"/>
                <ProgressBar x:Name="download_bar" HorizontalAlignment="Left" Height="32" Margin="500,566,0,0" VerticalAlignment="Top" Width="476" Foreground="#FF25A98E" Grid.ColumnSpan="2"/>
                <TextBlock x:Name="download_text" HorizontalAlignment="Left" Margin="500,566,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="28" Width="470" TextAlignment="Center" FontSize="18" Grid.ColumnSpan="2"/>
                <Button x:Name="convert_button" Content="CONVERT&#xD;&#xA;" Margin="223,170,0,0" Click="convert_button_Click" HorizontalAlignment="Left" Width="140" Foreground="#FFE4AB0F" Height="60" VerticalAlignment="Top" Visibility="Hidden" Grid.Column="1"/>
                <ToggleButton x:Name="develop_button" Content="Develop" Height="40" Margin="327,186,0,0" Width="152" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FF1C9682" Background="#FF1F1F1F" Checked="develop_button_Checked" Unchecked="develop_button_Unchecked" BorderBrush="#FF1C9682" BorderThickness="0,0,0,0" IsChecked="False" Grid.Column="1"/>
                <CheckBox x:Name="debug_log_checkbox" Content="Debug Log" HorizontalAlignment="Left" Margin="355,142,0,0" VerticalAlignment="Top" Checked="debug_log_checkbox_Checked" Unchecked="debug_log_checkbox_Unchecked" Grid.Column="1"/>
                <CheckBox x:Name="variable_dump_checkbox" Content="Variable Dump" HorizontalAlignment="Left" Margin="353,110,0,0" VerticalAlignment="Top" Checked="variable_dump_checkbox_Checked" Unchecked="variable_dump_checkbox_Unchecked" Grid.Column="1"/>
                <Button x:Name="dev_install_button" Content="Install" Height="59" Margin="351,31,0,0" Width="113" HorizontalAlignment="Left" VerticalAlignment="Top" Click="dev_install_button_Click" Foreground="#FF25A98E" FontSize="28" Grid.Column="1" BorderBrush="#FF1C9682" FontWeight="Bold"/>


            </Grid>
        </TabItem>
        <TabItem x:Name="options_tab" HorizontalAlignment="Center" Height="25" Header="Options" VerticalAlignment="Center" Width="81">
            <Grid Background="#FF0F0F0F" Width="1005">
                <Button x:Name="launcher_button" Content="Launcher" Click="launcher_button_Click" Foreground="#FFFB994B" Grid.IsSharedSizeScope="True" VerticalAlignment="Top" Width="100" Height="40" Opacity="0.85" Background="Black" HorizontalAlignment="Left" Margin="449,262,0,0" FontWeight="Bold"/>
                <Button x:Name="controller_button" Content="Controller" Foreground="#FFFB994B" Grid.IsSharedSizeScope="True" Background="Black" BorderBrush="#FFC55757" Opacity="0.85" Click="controller_button_Click" Width="100" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="449,362,0,0" FontWeight="Bold"/>
                <Button x:Name="System_button" Click="system_button_Click" Foreground="#FFFB994B" Grid.IsSharedSizeScope="True" Background="Black" BorderBrush="#FFC55757" Opacity="0.85" Width="100" Content="System" Height="38" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="449,313,0,0" FontWeight="Bold"/>
                <Button x:Name="profile_button" Content="Profile" Click="profile_button_Click" Foreground="#FFE4AB0F" Grid.IsSharedSizeScope="True" Margin="0,125,478,0" VerticalAlignment="Top" Width="100" Height="40" HorizontalAlignment="Right" Visibility="Hidden"/>
                <Button x:Name="back_button" Content="Back" Click="back_button_Click" Foreground="#FFFB994B" Grid.IsSharedSizeScope="True"  Background="Black" BorderBrush="#FFC55757" BorderThickness="1,1,1,1" Opacity="0.85" Width="100" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="449,413,0,0" FontWeight="Bold"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="mods_tab" Header="Mods">
            <Grid Background="#FFE5E5E5">
                <ctrl:MyModsUserControl x:Name="ctrlMyMods" Margin="0,-2,0,-1"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="catalog_tab" Header="Catalog" HorizontalAlignment="Right" Width="81">
            <Grid Background="#FFE5E5E5">
                <ctrl:CatalogUserControl x:Name="ctrlCatalog" Margin="0,-3,0,-2"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
